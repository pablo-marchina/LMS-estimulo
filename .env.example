# Canonical local example. Copy to apps/web/.env.local.
APP_ENV=development

# Supabase development/test project. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Official Estímulo brand asset. Override only with an approved asset URL.
NEXT_PUBLIC_ESTIMULO_LOGO_URL=https://cdn.prod.website-files.com/63dbfdf887f6a1cca0e4cbcc/641253f973926c213bb9dabd_logo-estimulo.png

# Public signup for local development/tests only. Keep disabled by default.
# The application also rejects this feature whenever NODE_ENV=production.
PUBLIC_SIGNUP_TEST_MODE=false

# Optional synthetic Browser E2E runtime.
BROWSER_E2E_MODE=
BROWSER_E2E_TOKEN=
BROWSER_E2E_STATE_FILE=.tmp/browser-e2e-state.json
BROWSER_E2E_STORAGE_DIR=.tmp/browser-e2e-storage

# Copy to .env at the repository root before running the web application.
APP_ENV=development
PLATFORM_RUNTIME_PROVIDER=supabase
# Production and staging require PLATFORM_RUNTIME_PROVIDER=aws.
# Supabase and Vercel are restricted to development, test and preview.
# AWS production architecture is not yet approved; production readiness remains 503.

# Local development URL. A definitive AWS public origin will be defined by architecture ADR.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SOURCE_VERSION=local

# Supabase development/test adapter. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
AUTHENTICATED_RPC_FUNCTION_URL=

# Server-side gateway budgets for development/test and preview.
# Definitive distributed production controls remain an open AWS architecture decision.
RPC_GATEWAY_TIMEOUT_MS=10000
RPC_GATEWAY_MAX_PAYLOAD_BYTES=262144
RPC_GATEWAY_MAX_CONCURRENCY=32
RPC_GATEWAY_MAX_QUEUE=128
RPC_GATEWAY_QUEUE_TIMEOUT_MS=1000
READINESS_DATABASE_TIMEOUT_MS=5000

# Supabase Edge Function defense-in-depth limits (per isolate, not a production rate limiter).
AUTHENTICATED_RPC_MAX_BODY_BYTES=262144
AUTHENTICATED_RPC_UPSTREAM_TIMEOUT_MS=10000
AUTHENTICATED_RPC_BURST_LIMIT=120
AUTHENTICATED_RPC_BURST_WINDOW_MS=60000
AUTHENTICATED_RPC_LOG_SAMPLE_RATE=0.1

# Only AWS setting currently implied by Dockerfile.lambda.
# Identity, data, storage, edge, networking, async processing, observability and
# deployment variables must not be invented before their ADRs are approved.
AWS_REGION=

# Required server-only CPF protection keys. Generate two independent 32-byte random values
# and encode each with base64. Never reuse either key for another purpose.
CPF_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CPF_LOOKUP_HMAC_KEY=replace-with-independent-base64-encoded-32-byte-key

# External integration test adapter. Keep unset until inventory, destination properties,
# scopes, sandbox behavior and the definitive production delivery architecture are approved.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT_MS=20000

# Brand assets are bundled locally under apps/web/public/brand.

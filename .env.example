# Copy to .env at the repository root before running the web application.
APP_ENV=development
# Local development. Preview deployments may derive their URL from the hosting platform.
# AWS staging/production must set the approved HTTPS domain for the target environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase development/test project. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required server-only CPF protection keys. Generate two independent 32-byte random values
# and encode each with base64. Never reuse either key for another purpose.
CPF_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CPF_LOOKUP_HMAC_KEY=replace-with-independent-base64-encoded-32-byte-key

# Real HubSpot adapter. Keep unset until the portal inventory, exact internal object IDs,
# destination properties, scopes, and sandbox are approved. No idProperty lookup is performed.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT_MS=20000

# Brand assets are bundled locally under apps/web/public/brand.

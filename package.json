{
  "name": "plataforma-estimulo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @estimulo/web run dev",
    "build:web": "npm --workspace @estimulo/web run build",
    "typecheck:web": "npm --workspace @estimulo/web run typecheck",
    "validate:repository": "node scripts/repository/validate-hygiene.mjs",
    "validate:e14-step5": "node scripts/e14/validate-step5-app-foundation.mjs",
    "validate:e14-runtime-history": "node scripts/e14/runtime-source-recovery/validate-recovered-history.mjs --manifest supabase/canonical-migrations/M13_RUNTIME_MANIFEST.json --migrations-dir supabase/migrations --canonical-file supabase/canonical-migrations/20260709051056_m13_e14_runtime_canonical.sql && node scripts/e14/runtime-source-recovery/validate-recovered-history.mjs --manifest supabase/canonical-migrations/M14_RUNTIME_MANIFEST.json --migrations-dir supabase/migrations --canonical-file supabase/canonical-migrations/20260709183504_m14_application_canonical.sql",
    "test:e14-step5": "node --test scripts/e14/validate-step5-app-foundation.test.mjs",
    "test:e14-runtime-recovery": "node --test scripts/e14/runtime-source-recovery/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}

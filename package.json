{
  "name": "plataforma-estimulo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @estimulo/web run dev",
    "build:web": "npm --workspace @estimulo/web run build",
    "typecheck:web": "npm --workspace @estimulo/web run typecheck",
    "validate:e14-step5": "node scripts/e14/validate-step5-app-foundation.mjs",
    "test:e14-step5": "node --test scripts/e14/validate-step5-app-foundation.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}

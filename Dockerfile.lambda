# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
ARG LAMBDA_ADAPTER_IMAGE=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1

FROM ${LAMBDA_ADAPTER_IMAGE} AS lambda-adapter

FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
RUN test "$(npm --version)" = "10.9.8" \
    && npm ci --ignore-scripts --no-audit --no-fund

FROM dependencies AS builder
WORKDIR /app
COPY . .
ARG NEXT_PUBLIC_APP_URL
ARG SOURCE_VERSION=unknown
ENV APP_ENV=production \
    PLATFORM_RUNTIME_PROVIDER=aws \
    NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} \
    SOURCE_VERSION=${SOURCE_VERSION}
RUN npm run build:web

FROM ${NODE_IMAGE} AS runner
ARG SOURCE_VERSION=unknown
COPY --from=lambda-adapter /lambda-adapter /opt/extensions/lambda-adapter
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
        /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app
WORKDIR /var/task
ENV NODE_ENV=production \
    APP_ENV=production \
    PLATFORM_RUNTIME_PROVIDER=aws \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    AWS_LWA_PORT=3000 \
    AWS_LWA_READINESS_CHECK_PATH=/api/health/live \
    AWS_LWA_READINESS_CHECK_HEALTHY_STATUS=200 \
    AWS_LWA_ENABLE_COMPRESSION=true \
    NODE_OPTIONS=--enable-source-maps \
    SOURCE_VERSION=${SOURCE_VERSION} \
    HOME=/tmp \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/.cache
COPY --from=builder --chown=10001:10001 /app/apps/web/.next/standalone ./
COPY --from=builder --chown=10001:10001 /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=10001:10001 /app/apps/web/public ./apps/web/public
RUN rm -rf /var/task/apps/web/.next/cache \
    && mkdir -p /tmp/next-cache /tmp/.cache \
    && ln -s /tmp/next-cache /var/task/apps/web/.next/cache \
    && chown -R 10001:10001 /var/task /tmp/next-cache /tmp/.cache
LABEL org.opencontainers.image.source="https://github.com/pablo-marchina/LMS-estimulo" \
      org.opencontainers.image.revision="${SOURCE_VERSION}"
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health/live').then((response)=>process.exit(response.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "apps/web/server.js"]

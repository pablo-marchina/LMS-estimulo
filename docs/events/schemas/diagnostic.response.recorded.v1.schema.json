{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.estimulo.org/events/diagnostic/response-recorded/1.0.0.json",
  "title": "diagnostic.response.recorded data v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnostic_session_id",
    "item_version_id",
    "response_value",
    "response_sequence",
    "answered_at"
  ],
  "properties": {
    "diagnostic_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "response_value": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 20
        }
      ]
    },
    "response_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "answered_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_time_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrepreneur_id"
      ],
      "properties": {
        "entrepreneur_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
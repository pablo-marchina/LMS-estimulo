{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.estimulo.org/events/learning/activity-completed/1.0.0.json",
  "title": "learning.activity.completed data v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activity_instance_id",
    "activity_version_id",
    "journey_instance_id",
    "completion_policy_version",
    "completed_at",
    "evidence_refs"
  ],
  "properties": {
    "activity_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "activity_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "journey_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "completion_policy_version": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "active_duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrepreneur_id"
      ],
      "properties": {
        "entrepreneur_id": {
          "type": "string",
          "format": "uuid"
        },
        "business_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_assignment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "path_step_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "verification_status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "server_transactional",
            "server_acknowledged",
            "external_confirmed",
            "client_observed",
            "self_reported",
            "reviewer_validated"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "not_applicable"
          ]
        }
      }
    }
  }
}
{
  "commands": [
    {
      "id": "CMD08_ACKNOWLEDGE_ACTIVITY_SECTION",
      "kind": "command",
      "method": "PUT",
      "path": "/v1/me/activity-sessions/{activity_session_id}/sections/{section_code}",
      "actor": "participant",
      "authorization": "participant owns the active activity session",
      "request_required": [
        "acknowledged=true",
        "Idempotency-Key"
      ],
      "transaction": "use deterministic event id for session plus section; append progress event once; increment accepted_observation_count only when event is new",
      "reads": [
        "orchestration.activity_sessions",
        "catalog.activity_versions",
        "eventing.events"
      ],
      "writes": [
        "orchestration.activity_sessions",
        "orchestration.progress_projections",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "learning.activity.progressed"
      ],
      "success": {
        "status": 200,
        "state": "in_progress",
        "fields": [
          "section_code",
          "acknowledged",
          "acknowledged_sections",
          "required_sections",
          "completion_ratio"
        ]
      },
      "idempotency": "same section cannot increase observation count or progress twice",
      "failures": [
        {
          "condition": "section not present in published activity configuration",
          "status": 422,
          "code": "UNKNOWN_CONTENT_SECTION",
          "effects": "none"
        },
        {
          "condition": "activity not in progress",
          "status": 409,
          "code": "ACTIVITY_NOT_ACTIVE",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only",
      "design_note": "section acknowledgement source of truth is the immutable progress event; accepted_observation_count is a projection"
    },
    {
      "id": "CMD09_START_QUICK_CHECK",
      "kind": "command",
      "method": "POST",
      "path": "/v1/me/step-instances/{step_instance_id}/assessment-attempts",
      "actor": "participant",
      "authorization": "participant owns the in-progress step",
      "request_required": [
        "Idempotency-Key"
      ],
      "transaction": "calculate next attempt number under lock, enforce max_attempts, insert attempt and append attempt-started event",
      "reads": [
        "orchestration.step_instances",
        "assessment.assessment_specs",
        "assessment.attempts"
      ],
      "writes": [
        "assessment.attempts",
        "orchestration.step_instances",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "assessment.attempt.started"
      ],
      "success": {
        "status": 201,
        "state": "in_progress",
        "fields": [
          "attempt_id",
          "attempt_number",
          "max_attempts",
          "question"
        ]
      },
      "idempotency": "same key returns the same attempt; different key creates the next attempt only if no attempt is active",
      "failures": [
        {
          "condition": "max attempts reached",
          "status": 409,
          "code": "MAX_ATTEMPTS_REACHED",
          "effects": "none"
        },
        {
          "condition": "another attempt is active",
          "status": 409,
          "code": "ATTEMPT_ALREADY_ACTIVE",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only"
    },
    {
      "id": "CMD10_RECORD_QUICK_CHECK_ANSWER",
      "kind": "command",
      "method": "PUT",
      "path": "/v1/me/assessment-attempts/{attempt_id}/responses/{question_id}",
      "actor": "participant",
      "authorization": "participant owns the active attempt",
      "request_required": [
        "option_code",
        "Idempotency-Key"
      ],
      "transaction": "append answer-recorded event and insert one response referencing the source event",
      "reads": [
        "assessment.attempts",
        "assessment.questions",
        "assessment.answer_options"
      ],
      "writes": [
        "eventing.events",
        "assessment.responses",
        "eventing.outbox"
      ],
      "events": [
        "assessment.answer.recorded"
      ],
      "success": {
        "status": 200,
        "state": "answer_recorded",
        "fields": [
          "response_id",
          "question_id",
          "recorded_at"
        ]
      },
      "idempotency": "unique attempt plus question and deterministic event; same answer replays, changed answer requires an explicit replace command not included in this vertical",
      "failures": [
        {
          "condition": "option not part of question",
          "status": 422,
          "code": "INVALID_ANSWER_OPTION",
          "effects": "none"
        },
        {
          "condition": "attempt not in progress",
          "status": 409,
          "code": "ATTEMPT_CLOSED",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only"
    },
    {
      "id": "CMD11_SUBMIT_QUICK_CHECK",
      "kind": "command",
      "method": "POST",
      "path": "/v1/me/assessment-attempts/{attempt_id}/submit",
      "actor": "participant",
      "authorization": "participant owns the attempt; scoring, completion and points execute as trusted worker",
      "request_required": [
        "expected_aggregate_version",
        "Idempotency-Key"
      ],
      "transaction": "lock attempt, step and journey; append submitted event; score the immutable answer; insert result; close attempt; append scored and pass/fail events; on pass complete step and journey, update progress to 100 percent, append completion events and insert two idempotent point ledger entries; append feedback event; all effects and outbox rows are atomic",
      "reads": [
        "assessment.attempts",
        "assessment.responses",
        "assessment.questions",
        "assessment.answer_options",
        "assessment.assessment_specs",
        "orchestration.step_instances",
        "orchestration.journey_instances",
        "engagement.point_rule_versions"
      ],
      "writes_on_all_submissions": [
        "assessment.attempts",
        "assessment.results",
        "eventing.events",
        "eventing.outbox"
      ],
      "writes_on_pass": [
        "orchestration.step_instances",
        "orchestration.path_assignments",
        "orchestration.journey_instances",
        "orchestration.progress_projections",
        "engagement.point_ledger",
        "eventing.events",
        "eventing.outbox"
      ],
      "events_on_all_submissions": [
        "assessment.attempt.submitted",
        "assessment.attempt.scored",
        "assessment.feedback.available"
      ],
      "events_on_fail": [
        "assessment.attempt.failed"
      ],
      "events_on_pass": [
        "assessment.attempt.passed",
        "learning.activity.completed",
        "engagement.points.awarded",
        "journey.path.completed",
        "journey.instance.completed"
      ],
      "success": {
        "status": 200,
        "failed_state": "attempt_failed_activity_in_progress",
        "passed_state": "journey_completed",
        "fields": [
          "attempt_id",
          "passed",
          "score",
          "feedback",
          "attempts_remaining",
          "activity.status",
          "progress.completion_ratio",
          "points.balance"
        ]
      },
      "idempotency": "duplicate submission returns identical result; passing replay creates no additional ledger entry, completion transition, event or outbox row",
      "failures": [
        {
          "condition": "answer missing",
          "status": 422,
          "code": "ASSESSMENT_INCOMPLETE",
          "effects": "none"
        },
        {
          "condition": "stale attempt or step aggregate",
          "status": 409,
          "code": "AGGREGATE_VERSION_CONFLICT",
          "effects": "none"
        },
        {
          "condition": "scoring configuration invalid",
          "status": 500,
          "code": "ASSESSMENT_CONFIGURATION_ERROR",
          "effects": "all submission effects rolled back"
        },
        {
          "condition": "point, event or outbox insert fails",
          "status": 500,
          "code": "ATOMIC_WRITE_FAILED",
          "effects": "all submission, completion, progress, point, event and outbox effects roll back"
        }
      ],
      "implementation_status": "contract_only",
      "writes": [
        "assessment.attempts",
        "assessment.results",
        "engagement.point_ledger",
        "eventing.events",
        "eventing.outbox",
        "orchestration.journey_instances",
        "orchestration.path_assignments",
        "orchestration.progress_projections",
        "orchestration.step_instances"
      ],
      "events": [
        "assessment.attempt.failed",
        "assessment.attempt.passed",
        "assessment.attempt.scored",
        "assessment.attempt.submitted",
        "assessment.feedback.available",
        "engagement.points.awarded",
        "journey.instance.completed",
        "journey.path.completed",
        "learning.activity.completed"
      ]
    }
  ]
}

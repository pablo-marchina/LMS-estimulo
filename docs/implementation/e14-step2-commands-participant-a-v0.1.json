{
  "commands": [
    {
      "id": "CMD03_START_JOURNEY",
      "kind": "command",
      "method": "POST",
      "path": "/v1/me/journey-instances/{journey_instance_id}/start",
      "actor": "participant",
      "authorization": "authenticated entrepreneur owns the enrollment and it is assigned or available",
      "request_required": [
        "expected_aggregate_version",
        "Idempotency-Key"
      ],
      "transaction": "activate enrollment and start journey instance; append activation and start events",
      "reads": [
        "orchestration.enrollments",
        "orchestration.journey_instances"
      ],
      "writes": [
        "orchestration.enrollments",
        "orchestration.journey_instances",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "journey.enrollment.activated",
        "journey.instance.started"
      ],
      "success": {
        "status": 200,
        "state": "started",
        "fields": [
          "journey_instance_id",
          "status",
          "started_at",
          "aggregate_version"
        ]
      },
      "idempotency": "replay returns current started state",
      "failures": [
        {
          "condition": "participant is not enrolled",
          "status": 403,
          "code": "ENROLLMENT_REQUIRED",
          "effects": "none"
        },
        {
          "condition": "enrollment expired or cancelled",
          "status": 409,
          "code": "ENROLLMENT_INACTIVE",
          "effects": "none"
        },
        {
          "condition": "stale aggregate version",
          "status": 409,
          "code": "AGGREGATE_VERSION_CONFLICT",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only"
    },
    {
      "id": "CMD04_START_DIAGNOSTIC",
      "kind": "command",
      "method": "POST",
      "path": "/v1/me/journey-instances/{journey_instance_id}/diagnostic-sessions",
      "actor": "participant",
      "authorization": "participant owns an active journey instance",
      "request_required": [
        "diagnostic_version_id",
        "Idempotency-Key"
      ],
      "transaction": "insert one in-progress diagnostic session for the published diagnostic version; append session-started event",
      "reads": [
        "orchestration.journey_instances",
        "diagnostics.diagnostic_versions"
      ],
      "writes": [
        "diagnostics.sessions",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "diagnostic.session.started"
      ],
      "success": {
        "status": 201,
        "state": "in_progress",
        "fields": [
          "diagnostic_session_id",
          "status",
          "started_at",
          "items"
        ]
      },
      "idempotency": "same key returns the same session; a second different key while active returns conflict",
      "failures": [
        {
          "condition": "journey not started",
          "status": 409,
          "code": "JOURNEY_NOT_STARTED",
          "effects": "none"
        },
        {
          "condition": "diagnostic version not part of journey",
          "status": 422,
          "code": "DIAGNOSTIC_NOT_ALLOWED",
          "effects": "none"
        },
        {
          "condition": "another session is active",
          "status": 409,
          "code": "DIAGNOSTIC_ALREADY_ACTIVE",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only"
    },
    {
      "id": "CMD05_RECORD_DIAGNOSTIC_RESPONSE",
      "kind": "command",
      "method": "PUT",
      "path": "/v1/me/diagnostic-sessions/{session_id}/responses/{item_id}",
      "actor": "participant",
      "authorization": "participant owns the active session",
      "request_required": [
        "option_code",
        "revision",
        "Idempotency-Key"
      ],
      "transaction": "append response-recorded event, insert immutable response revision referencing source_event_id, and link superseded revision when present",
      "reads": [
        "diagnostics.sessions",
        "diagnostics.items",
        "diagnostics.item_options",
        "diagnostics.responses"
      ],
      "writes": [
        "eventing.events",
        "diagnostics.responses",
        "eventing.outbox"
      ],
      "events": [
        "diagnostic.response.recorded"
      ],
      "success": {
        "status": 200,
        "state": "response_recorded",
        "fields": [
          "response_id",
          "item_id",
          "revision",
          "recorded_at"
        ]
      },
      "idempotency": "same item, revision and key returns the same response; a new answer requires revision + 1",
      "failures": [
        {
          "condition": "option does not belong to item",
          "status": 422,
          "code": "INVALID_DIAGNOSTIC_OPTION",
          "effects": "none"
        },
        {
          "condition": "revision skips or repeats with different payload",
          "status": 409,
          "code": "RESPONSE_REVISION_CONFLICT",
          "effects": "none"
        },
        {
          "condition": "session already completed",
          "status": 409,
          "code": "DIAGNOSTIC_SESSION_CLOSED",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only"
    },
    {
      "id": "CMD06_COMPLETE_DIAGNOSTIC_AND_ASSIGN_PATH",
      "kind": "command",
      "method": "POST",
      "path": "/v1/me/diagnostic-sessions/{session_id}/complete",
      "actor": "participant",
      "authorization": "participant owns the active session; calculation and assignment execute as trusted worker",
      "request_required": [
        "expected_aggregate_version",
        "Idempotency-Key"
      ],
      "preconditions": [
        "all four required items have a current response"
      ],
      "transaction": "lock session and journey aggregate; calculate two dimensions; store result and dimension results; close session; assign guided or standard path; create one step instance for the shared activity; initialize personalization decision; append all causal events and outbox rows",
      "reads": [
        "diagnostics.sessions",
        "diagnostics.responses",
        "diagnostics.items",
        "diagnostics.item_options",
        "orchestration.path_templates",
        "orchestration.path_steps"
      ],
      "writes": [
        "diagnostics.sessions",
        "diagnostics.results",
        "diagnostics.dimension_results",
        "orchestration.personalization_decisions",
        "orchestration.path_assignments",
        "orchestration.step_instances",
        "orchestration.progress_projections",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "diagnostic.session.completed",
        "diagnostic.result.generated",
        "personalization.uncertainty.recorded",
        "journey.path.assigned",
        "journey.path.started",
        "journey.step.available"
      ],
      "success": {
        "status": 200,
        "state": "path_assigned",
        "fields": [
          "diagnostic_result_id",
          "dimension_scores",
          "low_confidence",
          "path.code",
          "path_assignment_id",
          "next_step"
        ]
      },
      "display_rule": "low-confidence is shown as a support choice, never as a trait or score",
      "persistence_mapping": "welcome and diagnosis are pre-path phases; quick_check is embedded in the activity; both path templates persist one shared activity step, with guided presentation stored in path metadata",
      "idempotency": "replay returns the existing result, assignment and step; no second assignment is created",
      "failures": [
        {
          "condition": "required response missing",
          "status": 422,
          "code": "DIAGNOSTIC_INCOMPLETE",
          "effects": "none"
        },
        {
          "condition": "invalid option or scoring configuration",
          "status": 422,
          "code": "DIAGNOSTIC_CONFIGURATION_INVALID",
          "effects": "none"
        },
        {
          "condition": "stale session aggregate",
          "status": 409,
          "code": "AGGREGATE_VERSION_CONFLICT",
          "effects": "none"
        },
        {
          "condition": "event or assignment write fails",
          "status": 500,
          "code": "ATOMIC_WRITE_FAILED",
          "effects": "result, assignment and all events roll back"
        }
      ],
      "implementation_status": "contract_only"
    },
    {
      "id": "CMD07_START_ACTIVITY",
      "kind": "command",
      "method": "POST",
      "path": "/v1/me/step-instances/{step_instance_id}/start",
      "actor": "participant",
      "authorization": "participant owns the active path and the step is available",
      "request_required": [
        "expected_aggregate_version",
        "Idempotency-Key"
      ],
      "transaction": "set step to in_progress, create activity session, append activity-started event",
      "reads": [
        "orchestration.step_instances",
        "orchestration.path_assignments"
      ],
      "writes": [
        "orchestration.step_instances",
        "orchestration.activity_sessions",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "learning.activity.started"
      ],
      "success": {
        "status": 200,
        "state": "in_progress",
        "fields": [
          "step_instance_id",
          "activity_session_id",
          "status",
          "presentation_mode",
          "aggregate_version"
        ]
      },
      "idempotency": "replay returns the active session and does not create another session",
      "failures": [
        {
          "condition": "step is not available",
          "status": 409,
          "code": "STEP_NOT_AVAILABLE",
          "effects": "none"
        },
        {
          "condition": "step belongs to another participant",
          "status": 404,
          "code": "RESOURCE_NOT_FOUND",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only"
    }
  ]
}

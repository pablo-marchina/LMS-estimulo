{
  "commands": [
    {
      "id": "AUTH01_AUTHENTICATE_PARTICIPANT",
      "kind": "authentication",
      "method": "POST",
      "path": "/auth/v1/token",
      "actor": "participant",
      "authorization": "valid synthetic test account; successful identity mapping to one entrepreneur",
      "request_required": [
        "provider-supported credentials"
      ],
      "transaction": "authentication provider transaction; no LMS domain mutation",
      "reads": [
        "iam.user_accounts",
        "iam.external_identities",
        "core.entrepreneurs"
      ],
      "writes": [],
      "events": [],
      "success": {
        "status": 200,
        "state": "authenticated",
        "fields": [
          "access_token",
          "expires_in",
          "user.id"
        ]
      },
      "idempotency": "provider-defined; no LMS Idempotency-Key",
      "failures": [
        {
          "condition": "invalid credentials",
          "status": 401,
          "code": "AUTHENTICATION_FAILED",
          "effects": "none"
        },
        {
          "condition": "identity not mapped to entrepreneur",
          "status": 403,
          "code": "PARTICIPANT_PROFILE_UNAVAILABLE",
          "effects": "none"
        }
      ],
      "implementation_status": "provider_available_application_mapping_not_proven"
    },
    {
      "id": "CMD01_PUBLISH_VERTICAL",
      "kind": "command",
      "method": "POST",
      "path": "/v1/admin/journey-versions/{journey_version_id}/publish",
      "actor": "operator",
      "authorization": "journey.definition.publish on the owner organization; execution uses trusted worker context",
      "request_required": [
        "journey_version_id",
        "expected_content_hash",
        "Idempotency-Key"
      ],
      "preconditions": [
        "journey is internal_test_only",
        "journey, activity, diagnostic, assessment, paths and point rules are draft and internally consistent",
        "all referenced versions belong to the same owner organization",
        "OpenAI attribution is absent"
      ],
      "transaction": "validate full immutable graph; set all selected versions to published; set published_at; append four publication events and outbox routes",
      "reads": [
        "catalog.journey_definitions",
        "catalog.journey_versions",
        "catalog.activity_definitions",
        "catalog.activity_versions",
        "diagnostics.diagnostic_definitions",
        "diagnostics.diagnostic_versions",
        "diagnostics.dimensions",
        "diagnostics.items",
        "diagnostics.item_options",
        "assessment.assessment_specs",
        "assessment.questions",
        "assessment.answer_options",
        "orchestration.path_templates",
        "orchestration.path_steps",
        "engagement.point_rule_versions"
      ],
      "writes": [
        "catalog.journey_versions",
        "catalog.activity_versions",
        "diagnostics.diagnostic_versions",
        "orchestration.path_templates",
        "engagement.point_rule_versions",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "catalog.journey_version.published",
        "catalog.activity_version.published",
        "catalog.diagnostic_version.published",
        "catalog.assessment_version.published"
      ],
      "success": {
        "status": 200,
        "state": "published",
        "fields": [
          "journey_version_id",
          "status",
          "published_at",
          "content_hash"
        ]
      },
      "idempotency": "same key and graph returns the published graph; no duplicate event or outbox row",
      "failures": [
        {
          "condition": "operator lacks permission",
          "status": 403,
          "code": "FORBIDDEN",
          "effects": "none"
        },
        {
          "condition": "content hash differs",
          "status": 409,
          "code": "CONTENT_HASH_MISMATCH",
          "effects": "none"
        },
        {
          "condition": "graph incomplete or references non-published dependencies",
          "status": 422,
          "code": "JOURNEY_GRAPH_INVALID",
          "effects": "none"
        },
        {
          "condition": "any event or outbox insert fails",
          "status": 500,
          "code": "ATOMIC_WRITE_FAILED",
          "effects": "all publication changes rolled back"
        }
      ],
      "implementation_status": "contract_only",
      "schema_gap": "published-version immutability is not currently enforced by a database trigger"
    },
    {
      "id": "CMD02_CREATE_ENROLLMENT",
      "kind": "command",
      "method": "POST",
      "path": "/v1/admin/enrollments",
      "actor": "operator",
      "authorization": "journey.execution.manage on the journey owner organization",
      "request_required": [
        "entrepreneur_id",
        "journey_version_id",
        "source",
        "Idempotency-Key"
      ],
      "preconditions": [
        "journey version is published",
        "participant is synthetic and active",
        "journey is internal_test_only"
      ],
      "transaction": "insert enrollment, journey instance and zeroed progress projection; append enrollment-created and instance-available events",
      "reads": [
        "core.entrepreneurs",
        "catalog.journey_versions"
      ],
      "writes": [
        "orchestration.enrollments",
        "orchestration.journey_instances",
        "orchestration.progress_projections",
        "eventing.events",
        "eventing.outbox"
      ],
      "events": [
        "journey.enrollment.created",
        "journey.instance.available"
      ],
      "success": {
        "status": 201,
        "state": "assigned",
        "fields": [
          "enrollment_id",
          "journey_instance_id",
          "status",
          "progress.completion_ratio"
        ]
      },
      "idempotency": "natural enrollment uniqueness plus deterministic command event; replay returns the existing enrollment",
      "failures": [
        {
          "condition": "journey is not published",
          "status": 409,
          "code": "JOURNEY_NOT_PUBLISHED",
          "effects": "none"
        },
        {
          "condition": "duplicate logical enrollment with different key",
          "status": 409,
          "code": "ENROLLMENT_ALREADY_EXISTS",
          "effects": "none"
        },
        {
          "condition": "cross-organization participant or journey",
          "status": 404,
          "code": "RESOURCE_NOT_FOUND",
          "effects": "none"
        }
      ],
      "implementation_status": "contract_only"
    }
  ]
}

# Copy to an untracked file and replace every placeholder after change approval.
confirm_deployment      = false
expected_aws_account_id = "000000000000"
aws_region              = "sa-east-1"
container_image         = "000000000000.dkr.ecr.sa-east-1.amazonaws.com/lms-estimulo-staging-web@sha256:REPLACE_WITH_64_HEX_CHARACTERS"
certificate_arn         = "arn:aws:acm:sa-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
domain_name             = ""
route53_zone_id          = ""
alarm_email              = ""

# These values are public browser configuration. The exact same values must be
# passed as NEXT_PUBLIC_* build arguments when producing container_image.
public_environment = {
  app_url           = "https://staging.example.org"
  supabase_url      = "https://replace.supabase.co"
  supabase_anon_key = "replace-with-public-anon-or-publishable-key"
}

# Only server-side credentials belong in Secrets Manager.
secret_arns = {
  SUPABASE_SERVICE_ROLE_KEY = "arn:aws:secretsmanager:sa-east-1:000000000000:secret:replace-service-role"
  CPF_ENCRYPTION_KEY        = "arn:aws:secretsmanager:sa-east-1:000000000000:secret:replace-cpf-encryption"
  CPF_LOOKUP_HMAC_KEY       = "arn:aws:secretsmanager:sa-east-1:000000000000:secret:replace-cpf-hmac"
  # Optional after external approvals:
  # HUBSPOT_PRIVATE_APP_TOKEN = "arn:aws:secretsmanager:..."
  # HUBSPOT_PORTAL_ID         = "arn:aws:secretsmanager:..."
  # MALWARE_SCANNER_URL       = "arn:aws:secretsmanager:..."
  # MALWARE_SCANNER_API_KEY   = "arn:aws:secretsmanager:..."
}
